+	draw_line(Vector2(7.0, 0.0), Vector2(7.0, top), rail_color, 3.0)
+	var y := -8.0
+	while y > top + 4.0:
+		draw_line(Vector2(-7.0, y), Vector2(7.0, y), rung_color, 2.0)
+		y -= 12.0
